{
  "name": "docudb",
  "version": "0.1.0",
  "description": "Embedded document-based NoSQL database for Node.js with MongoDB-like queries, zero runtime dependencies",
  "keywords": [
    "database",
    "nosql",
    "document-database",
    "embedded",
    "mongodb-like",
    "chunks",
    "compression",
    "indexes",
    "typescript",
    "offline-first",
    "nodejs"
  ],
  "homepage": "https://github.com/danielxceron/DocuDB#readme",
  "bugs": {
    "url": "https://github.com/danielxceron/DocuDB/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielxceron/DocuDB.git",
    "directory": "."
  },
  "license": "MIT",
  "author": "Daniel Cerón Claros",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsup",
    "build:types": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && mocha",
    "build:test": "tsc -p tsconfig.test.json",
    "test:watch": "tsc -p tsconfig.test.json && mocha --watch",
    "bench": "npm run build:bench && node dist-bench/bench/bench.js",
    "build:bench": "tsc -p tsconfig.bench.json",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run docs:check && npm run build",
    "docs:check": "node scripts/docs-check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.20",
    "chai": "^5.2.0",
    "mocha": "^11.3.0",
    "ts-standard": "^12.0.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "eslintConfig": {
    "extends": "./node_modules/ts-standard/eslintrc.json",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "ignorePatterns": [
      "dist/**/*",
      "dist-bench/**/*",
      "coverage/**/*",
      "data/**/*"
    ],
    "rules": {
      "@typescript-eslint/no-unused-expressions": "off",
      "@typescript-eslint/no-dynamic-delete": "off",
      "@typescript-eslint/return-await": "off",
      "@typescript-eslint/strict-boolean-expressions": "off",
      "@typescript-eslint/consistent-type-assertions": "off",
      "@typescript-eslint/no-invalid-void-type": "off",
      "@typescript-eslint/no-non-null-assertion": "off",
      "@typescript-eslint/promise-function-async": "off",
      "@typescript-eslint/restrict-template-expressions": "off",
      "@typescript-eslint/indent": "off",
      "no-template-curly-in-string": "off",
      "no-control-regex": "off",
      "no-useless-escape": "off"
    }
  },
  "dependencies": {
    "docudb": "file:docudb-0.1.0.tgz"
  }
}
